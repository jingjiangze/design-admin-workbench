# ===== 敏感数据（绝不入库）=====
# 抓包/取证文件可能包含 Cookie、Token、Session、账号信息
*.har
.env
.env.*
# frontend 模板自带 env 仅含编译期常量（端口/路径/CDN 开关），已人工审查无敏感数据；
# 凭据（账号/密码/Cookie/Token）仍禁止写入任何 env 文件
!frontend/.env
!frontend/.env.*
*.pem
*.key
cookies.txt
cookie*.txt
tokens.json
research/raw/session/
# 取证临时工作目录（HTML/JS/脚本可能含凭据与会话数据）
.tmp-evidence/

# ===== OS / IDE =====
Thumbs.db
.DS_Store
.idea/
.vscode/

# ===== Node（后续前端工程使用）=====
node_modules/
dist/
*.log
npm-debug.log*
.vite/
# wrangler 本地缓存（dev/构建产物，含本地状态不入库）
.wrangler/

# ===== WorkBuddy 本地状态 =====
.workbuddy/

# Wrangler dev secrets（任意目录）—— 绝对禁止提交
.dev.vars
