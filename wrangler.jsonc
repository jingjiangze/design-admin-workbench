// Cloudflare Workers 配置（长文 §三十一/§三十二/§三十三/§四十一）
//
// ⚠️ 首次部署前需要完成（步骤见 docs/CLOUDFLARE_DEPLOYMENT.md）：
//   1. npx wrangler d1 create design-workbench      → 回填 d1_databases[].database_id
//   2. npx wrangler kv namespace create SESSIONS    → 回填 kv_namespaces[].id
//   3. npx wrangler secret put SESSION_ENCRYPTION_KEY（base64 32 字节 AES-256）
//   4. 生产环境追加：npx wrangler secret put TURNSTILE_SECRET_KEY
// Secret 绝不写入本文件（长文 §三十四）。

{
  "name": "design-admin-workbench",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-20",

  // 现代 Workers Static Assets（非传统 Workers Sites）
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "design-workbench",
      // [VERIFIED] 2026-09-20 wrangler d1 create design-workbench（region APAC）
      "database_id": "c39661c8-db45-490b-ae24-7ef32029ba1d",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      // [VERIFIED] 2026-09-20 wrangler kv namespace create SESSIONS
      "id": "b599ff7cd7324a588f99cf08e0281a02"
    }
  ],

  // 顶层 vars = 最安全默认（Mock 关旧系统）。生产由 environments 覆盖。
  "vars": {
    "LEGACY_API_ENABLED": "false",
    "LEGACY_BASE_URL": "https://d.jndx.net"
  },

  "observability": {
    "enabled": true
  },

  // ⚠️ wrangler 4 的多环境键名是 "env"（不是 "environments"）。
  //    写错键名 wrangler 会静默忽略整个配置块（仅警告 Unexpected fields），
  //    --env preview/production 将报 No environment found。
  "env": {
    // development：远端 Mock（legacy=off），本地短时调试用 `wrangler dev`
    "development": {
      "vars": {
        "LEGACY_API_ENABLED": "false",
        "LEGACY_BASE_URL": "https://d.jndx.net"
      }
    },
    // preview：真实 Worker + preview 资源（legacy=off，防预览环境触旧系统）
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "design-workbench-preview",
          // [VERIFIED] 2026-09-20 wrangler d1 create design-workbench-preview（region APAC）
          "database_id": "c7801299-4c14-430c-bd02-6c89acb664a1",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSIONS",
          // [VERIFIED] 2026-09-20 wrangler kv namespace create SESSIONS --preview
          "id": "dc06e47f12ef4cdb87065717bde21450"
        }
      ],
      "vars": {
        "LEGACY_API_ENABLED": "false",
        "LEGACY_BASE_URL": "https://d.jndx.net"
      }
    },
    // staging：真实旧系统集成测试（长文 §四/§五：Legacy=ON + Mock=OFF，
    // 必须独立 KV 防 Session 污染；D1 复用 preview 库）。
    // ⚠️ kv id 待 CF-REAL-02 执行 `wrangler kv namespace create SESSIONS --env staging`
    //    后回填（需 API token）；回填前 `--env staging` 部署会因无效 id 失败。
    "staging": {
      "kv_namespaces": [
        {
          "binding": "SESSIONS",
          // [PENDING] CF-REAL-02：staging 独立 KV id 待回填
          "id": "STAGING_KV_ID_PENDING"
        }
      ],
      "vars": {
        "LEGACY_API_ENABLED": "true",
        "LEGACY_BASE_URL": "https://d.jndx.net"
      }
    },
    // production：legacy=on（由 Worker env 控制，前端无法篡改，长文 §四十三）
    "production": {
      "vars": {
        "LEGACY_API_ENABLED": "true",
        "LEGACY_BASE_URL": "https://d.jndx.net"
      }
    }
  }
}
